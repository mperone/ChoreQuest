# Safe local-development defaults only. Copy to .env and edit locally.
# Do not use these values for production.

SECRET_KEY=local-development-only-secret-key
TZ=America/Chicago
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
DATABASE_URL=sqlite+aiosqlite:///./data/chores_os_dev.db
CORS_ORIGINS=http://localhost:5173

# Used by frontend/vite.config.js for the local dev proxy.
CHOREQUEST_BACKEND_URL=http://localhost:8123

# Optional Web Push settings for local notification testing.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@example.com
